@startuml pipeline_preprocessing
skinparam backgroundColor white
skinparam defaultFontName "Arial"
skinparam defaultFontSize 10
skinparam shadowing false
skinparam activityBorderColor #1565C0
skinparam activityBackgroundColor #E3F2FD
skinparam arrowColor #1565C0

title Pipeline Pra-pemrosesan Citra

start

:Citra DICOM Mentah\n(Format .dcm, resolusi ~1024x1024 px);

fork
  partition "1. Pengolahan Citra Utama" {
    :Pembacaan File DICOM (pydicom)\nEkstrak array piksel;
    :Konversi ke uint8 (0 - 255)\nnp.clip + normalisasi linear;
    if (Terapkan Lung Window?) then (Ya)
      :Windowing HU\nClamp ke range [L-W/2, L+W/2];
    else (Tidak)
      :Min-Max Normalisasi ke [0, 1];
    endif
    :Resize ke Target Ukuran\n512 x 512 piksel;
    :Duplikasi ke 3 Kanal (RGB semu)\nagar sesuai format ImageNet;
  }
fork again
  partition "2. Pembangkitan Lung Mask (PSPNet)" {
    :Normalisasi ke [-1024, 1024]\nmenggunakan xrv.datasets.normalize;
    :XRayCenterCrop + XRayResizer(512)\n(torchxrayvision transforms);
    :Inferensi PSPNet\n(output: 1 x num_targets x 512 x 512);
    :Sigmoid, ambil kanal Left Lung + Right Lung;
    :Union mask, threshold > 0.5\nhasil: Binary Mask (0 atau 1);
    :Resize mask ke 512 x 512;
  }
end fork

:Perkalian Element-wise (Image x Lung Mask)\n(Area non-paru menjadi hitam/0);

:Normalisasi ImageNet\nmean=[0.485, 0.456, 0.406]\nstd=[0.229, 0.224, 0.225];

:Konversi ke Tensor PyTorch\n(B, 3, 512, 512);

fork
  partition "3. Pembangkitan Ground Truth" {
    :Baca Bounding Box CSV\n(format RSNA label);
    :Inisialisasi matriks nol 512 x 512;
    :Isi area bbox dengan nilai 1;
    :Binary Mask Ground Truth;
  }
fork again
  :Tensor Gambar Siap Latih;
end fork

:Pasangan Tensor (Image, Mask)\nsiap untuk DataLoader;

stop
@enduml
