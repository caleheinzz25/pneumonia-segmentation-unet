@startuml mekanisme_scse
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 11
skinparam shadowing false

title Mekanisme Atensi SCSE\n(Spatial & Channel Squeeze-and-Excitation)

rectangle "**Input Feature Map**\nU ∈ R^(C × H × W)" as input #E3F2FD

' === Channel SE (cSE) Branch ===
rectangle "**Channel SE (cSE)**" as cse_title #1565C0

rectangle "Global Average\nPooling\n(C × 1 × 1)" as gap #BBDEFB
rectangle "FC + ReLU\n(C/r × 1 × 1)" as fc1 #90CAF9
rectangle "FC + Sigmoid\n(C × 1 × 1)" as fc2 #64B5F6
rectangle "Channel-wise\nScale\n(C × H × W)" as cse_out #42A5F5

' === Spatial SE (sSE) Branch ===
rectangle "**Spatial SE (sSE)**" as sse_title #C62828

rectangle "Conv 1×1\n(1 × H × W)" as conv1x1 #FFCDD2
rectangle "Sigmoid\n(1 × H × W)" as sigmoid #EF9A9A
rectangle "Spatial-wise\nScale\n(C × H × W)" as sse_out #EF5350

' === Combination ===
rectangle "**Element-wise\nAddition (+)**" as add #FFA726
rectangle "**Output Feature Map**\nÛ ∈ R^(C × H × W)" as output #E8F5E9

' === Flow ===
input --> gap
gap --> fc1
fc1 --> fc2
fc2 --> cse_out

input --> conv1x1
conv1x1 --> sigmoid
sigmoid --> sse_out

cse_out --> add
sse_out --> add
add --> output

note right of cse_out
  Mengkalibrasi ulang
  **respons per-channel**
  (fitur mana yang penting)
end note

note right of sse_out
  Mengkalibrasi ulang
  **respons per-lokasi**
  (area mana yang penting)
end note

@enduml
