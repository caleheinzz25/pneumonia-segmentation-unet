@startuml arsitektur_efficientnet
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 11
skinparam shadowing false

title EfficientNet: Compound Scaling (Tan & Le, 2019)

' === Baseline Network ===
rectangle "**Baseline Network**\n(EfficientNet-B0)" as baseline #E3F2FD {
  rectangle "MBConv1\n(3×3, k=32)" as mb1 #BBDEFB
  rectangle "MBConv6\n(3×3, k=16)" as mb2 #90CAF9
  rectangle "MBConv6\n(5×5, k=24)" as mb3 #64B5F6
  rectangle "MBConv6\n(3×3, k=40)" as mb4 #42A5F5
  rectangle "MBConv6\n(5×5, k=80)" as mb5 #1E88E5
  rectangle "MBConv6\n(5×5, k=112)" as mb6 #1565C0
  rectangle "MBConv6\n(3×3, k=192)" as mb7 #0D47A1
}

mb1 --> mb2
mb2 --> mb3
mb3 --> mb4
mb4 --> mb5
mb5 --> mb6
mb6 --> mb7

' === Scaling Dimensions ===
rectangle "**Compound Scaling**\nφ = α^φ · β^φ · γ^φ\n(s.t. α · β² · γ² ≈ 2)" as compound #FFA726

rectangle "**Width Scaling (β)**\nLebih banyak channel\nper layer" as width #FFF9C4

rectangle "**Depth Scaling (α)**\nLebih banyak layer\n(lebih dalam)" as depth #C8E6C9

rectangle "**Resolution Scaling (γ)**\nResolusi input\nlebih tinggi" as resolution #FFCCBC

compound --> width
compound --> depth
compound --> resolution

' === EfficientNet-B3 ===
rectangle "**EfficientNet-B3**\nφ = 1.4\nResolusi: 300×300\nParameter: ~12M\nTop-1 Accuracy: 81.6%" as b3 #EF5350

width --> b3
depth --> b3
resolution --> b3

note bottom of b3
  Digunakan sebagai **encoder**
  pada penelitian ini dengan
  bobot **ImageNet pre-trained**
end note

@enduml
