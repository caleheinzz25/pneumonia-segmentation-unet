@startuml pipeline_pelatihan
skinparam backgroundColor white
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam activityBorderColor #1B5E20
skinparam activityBackgroundColor #E8F5E9
skinparam arrowColor #1B5E20

start

:Inisialisasi & Konfigurasi
* U-Net sCSE + EfficientNet-B3 (ImageNet)
* Split dataset pada tingkat Patient ID
* Optimizer AdamW & Cosine Annealing LR
* Setup AMP FP16 & Akumulasi Gradien (4 step);

:Mulai Pelatihan (Epoch = 1);

repeat
  if (Epoch <= 12?) then (Ya)
    :Warmup Phase\nEncoder dibekukan (frozen);
  else (Tidak)
    :Fine-Tuning Phase\nEncoder dilepas (unfrozen);
  endif

  :Training Phase (per batch)
  * Forward pass & hitung Unified Focal Loss
  * Akumulasi gradien 4 step + AMP backward
  * Update bobot via AdamW (setiap 4 step);

  :Validation Phase (no_grad)
  * Hitung rata-rata Validation Loss
  * Evaluasi metrik: Precision, Recall, Specificity;

  :Pembaruan Laju Belajar & Evaluasi Checkpoint
  * Update LR menggunakan Cosine Annealing
  * Simpan model terbaik jika Val Loss membaik;

  if (Patience Early Stopping > 35 epoch?) then (Ya)
    :Early Stopping Terpicu;
    stop
  else (Tidak)
    :Epoch++;
  endif

repeat while (Epoch <= Max Epoch?) is (Ya)
->Tidak;

:Selesai Pelatihan\nMuat bobot model terbaik untuk Evaluasi;
stop
@enduml
